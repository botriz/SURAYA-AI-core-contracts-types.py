SURAYA_ENV=development
SURAYA_DATA_DIR=/app/data
SURAYA_AUDIT_PATH=/app/data/audit.jsonl

# Required for all control-plane API routes outside GET / and GET /health.
# Generate a long random value and store it only in the hosting provider's secret manager.
SURAYA_API_TOKEN=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this value only in the hosting provider's secret manager.
SURAYA_SECRET_KEY=

# Model provider configuration
SURAYA_MODEL_PROVIDER=local

# Do not place real secrets in this file.
